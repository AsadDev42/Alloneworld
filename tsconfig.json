{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "types": ["bun"]
  },
  "include": ["hosting/**/*.mts", "module.mts", "prisma.config.ts", "prisma-composer.config.ts"]
}
